{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev.woia/schemas/re-rental-application-command/v1",
  "title": "Rental application command",
  "type": "object",
  "required": [
    "organization",
    "action",
    "target",
    "purpose",
    "now",
    "operation_id",
    "expected_revision",
    "authority",
    "source_authority",
    "evidence",
    "payload"
  ],
  "properties": {
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "rental-application.create",
        "rental-application.update",
        "rental-application.submit",
        "rental-application.evidence.link",
        "rental-application.decision.record",
        "guarantee.create",
        "guarantee.update"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "now": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "participant_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "field_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object"
    },
    "source_authority": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "human_decision": {
      "type": "object"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "rental-application.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "property_id": {
                "type": "string",
                "minLength": 1
              },
              "terms_ref": {
                "type": "string",
                "minLength": 1
              },
              "participants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subject_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "participant_role": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "subject_id",
                    "participant_role"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "field_values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subject_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "subject_id",
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "property_id",
              "terms_ref",
              "participants",
              "field_values"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "rental-application.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "field_values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subject_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "subject_id",
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "field_values"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "participant_scope",
          "field_scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "rental-application.submit"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "participant_scope",
          "field_scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "rental-application.evidence.link"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "subject_id": {
                "type": "string",
                "minLength": 1
              },
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "document_version_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "subject_id",
              "document_id",
              "document_version_id",
              "evidence_purpose"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "participant_scope",
          "field_scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "rental-application.decision.record"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "decision": {
                "enum": [
                  "ACCEPTED",
                  "REJECTED",
                  "DEFERRED"
                ]
              },
              "application_version": {
                "type": "integer",
                "minimum": 1
              },
              "reason_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "decision",
              "application_version",
              "reason_ref"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "participant_scope",
          "field_scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "guarantee.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "application_id": {
                "type": "string",
                "minLength": 1
              },
              "participants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subject_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "participant_role": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "subject_id",
                    "participant_role"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "coverage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "property_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "obligation_scope_code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "coverage_scope_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "terms_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "property_id",
                    "obligation_scope_code",
                    "coverage_scope_id",
                    "terms_ref"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "status": {
                "enum": [
                  "PROPOSED",
                  "ACCEPTED"
                ]
              }
            },
            "required": [
              "application_id",
              "participants",
              "coverage",
              "status"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "guarantee.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "application_id": {
                "type": "string",
                "minLength": 1
              },
              "participants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "subject_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "participant_role": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "subject_id",
                    "participant_role"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "coverage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "property_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "obligation_scope_code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "coverage_scope_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "terms_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "property_id",
                    "obligation_scope_code",
                    "coverage_scope_id",
                    "terms_ref"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "status": {
                "enum": [
                  "PROPOSED",
                  "ACCEPTED"
                ]
              }
            },
            "required": [
              "application_id",
              "participants",
              "coverage",
              "status"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
